{
  "name": "pmill/aws-cognito",
  "description": "A PHP client for AWS Cognito user pools (Solution Forest fork: PHP 8.2-8.5, web-token/jwt-library 4)",
  "keywords": [
    "php",
    "authentication",
    "aws",
    "cognito",
    "api"
  ],
  "homepage": "https://github.com/pmill/aws-cognito",
  "license": "MIT",
  "authors": [
    {
      "name": "pmill",
      "email": "dev.pmill@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "aws/aws-sdk-php": "^3.300",
    "web-token/jwt-library": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "pmill\\AwsCognito\\": "src/"
    }
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "pmill\\AwsCognito\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
